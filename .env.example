OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=openai:gpt-4o

# Optional free Gemini key from https://aistudio.google.com/apikey
# Flash has a free quota. Pro often reports limit: 0 for new keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# All paper sources work without keys. These only raise the rate limits.

# Your email: OpenAlex gives a higher rate limit to requests that identify a contact.
CONTACT_EMAIL=

# Free key from https://www.semanticscholar.org/product/api#api-key-form
# Without it, Semantic Scholar shares one throttled pool with every anonymous caller.
SEMANTIC_SCHOLAR_API_KEY=

# Free key from https://account.ncbi.nlm.nih.gov/settings/ (PubMed: 3/sec -> 10/sec)
NCBI_API_KEY=
